# ".env" NUNCA se sube al repositorio (ver .gitignore).
#
# Estas variables usan el prefijo EXPO_PUBLIC_ porque Expo (SDK 49+) las
# embebe automáticamente en el bundle de la app en tiempo de build/dev.
# No son secretas: la config de Firebase client-side es pública por diseño.
# La seguridad real la dan las Firestore/Storage Security Rules.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=