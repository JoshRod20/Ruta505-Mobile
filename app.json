{
  "expo": {
    "name": "Ruta505",
    "slug": "Ruta505",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./src/assets/splash-icon.png",
          "imageWidth": 300,
          "dark": {
            "backgroundColor": "#ffffff",
            "image": "./src/assets/splash-icon.png"
          }
        }
      ]
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "softwareKeyboardLayoutMode": "resize",
      "edgeToEdgeEnabled": false,
      "package": "com.kennrod20.Ruta505",
      "versionCode": 1
    },
    "extra": {
      "eas": {
        "projectId": "fe02da5c-c2c9-4b2c-b79b-3403f5e95001"
      }
    },
    "owner": "kennrod20"
  }
}