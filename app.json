{
  "expo": {
    "name": "Ruta505",
    "slug": "ruta505",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./src/assets/splash-icon.png",
          "imageWidth": 300,
          "dark": {
            "backgroundColor": "#ffffff",
            "image": "./src/assets/splash-icon.png"
          }
        }
      ]
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.kennrod20.Ruta505"
    },
    "extra": {
      "eas": {
        "projectId": "35422456-fbe5-4727-a9f4-02fe4e39a8c7"
      }
    },
    "owner": "crisvargasmz"
  }
}
